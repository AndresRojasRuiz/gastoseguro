# Proxy inverso con TLS automático (A02 y A04:2025).
# - Para dominios públicos Caddy obtiene certificados de Let's Encrypt (ACME).
# - Para *.localhost usa su CA interna (útil en laboratorio).
# - TLS 1.2/1.3 con suites modernas por defecto; HTTP se redirige a HTTPS.
{
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	reverse_proxy app:4000 {
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		-Server
		-Via
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}

	request_body {
		max_size 6MB
	}

	log {
		output stdout
		format json
	}
}
