# -----------------------------------------------------------------------------------------
# GastoSeguro - configuración del backend
#
# NO copies este fichero a mano con valores de ejemplo: ejecuta `npm run setup` en la raíz
# del proyecto y se generará backend/.env con secretos aleatorios propios de tu equipo.
# El fichero .env está excluido del control de versiones (.gitignore).
# -----------------------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Desarrollo: SQLite (fichero local). Producción: PostgreSQL, p. ej.
# DATABASE_URL=postgresql://gastoseguro:<contraseña>@db:5432/gastoseguro?sslmode=require
DATABASE_URL=file:./data/gastoseguro.db
DB_PROVIDER=sqlite

# Orígenes permitidos (CORS + verificación de Origin), separados por comas.
APP_ORIGIN=http://localhost:5173,http://localhost:4000
# Número de proxies inversos de confianza (0 en local, 1 detrás de Caddy/Nginx).
TRUST_PROXY=0

# Secretos (base64, mínimo 32 bytes aleatorios; DATA_ENCRYPTION_KEY exactamente 32 bytes).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
DATA_ENCRYPTION_KEY=
AUDIT_HMAC_KEY=

# Sesiones y autenticación
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=30
# Sesiones simultáneas por cuenta (al superarse se cierran las más antiguas)
MAX_SESSIONS_PER_USER=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_REGISTER_MAX=10
# Duración mínima uniforme de las respuestas de autenticación en ms (anti-enumeración por tiempo)
AUTH_MIN_RESPONSE_MS=400
# off | hibp (consulta k-anonimato a Have I Been Pwned)
PASSWORD_BREACH_CHECK=off
COOKIE_SECURE=true

# Ficheros
UPLOAD_DIR=./storage/receipts
MAX_UPLOAD_BYTES=5242880
STATIC_DIR=../frontend/dist

LOG_LEVEL=info

# Cuentas de demostración (solo desarrollo, npm run db:seed)
# Conservación de datos (RGPD art. 5.1.e): días que se conservan los gastos borrados y las
# sesiones cerradas antes de su eliminación definitiva, y periodicidad de la purga en horas
# (0 = desactivada; también puede lanzarse con "npm run db:purge").
RETENTION_DELETED_EXPENSES_DAYS=30
RETENTION_SESSIONS_DAYS=30
RETENTION_PURGE_INTERVAL_HOURS=24

SEED_ADMIN_EMAIL=admin@gastoseguro.local
SEED_ADMIN_PASSWORD=
SEED_AUDITOR_EMAIL=auditor@gastoseguro.local
SEED_AUDITOR_PASSWORD=
SEED_USER_EMAIL=demo@gastoseguro.local
SEED_USER_PASSWORD=
