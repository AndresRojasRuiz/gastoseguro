// FICHERO GENERADO por scripts/postgres-schema.mjs: no editar a mano.
// Modelo de datos de GastoSeguro.
//
// Decisiones de seguridad relevantes:
//  - Identificadores UUID v4 (no secuenciales) para evitar la enumeración de recursos (A01).
//  - Importes almacenados como enteros en unidades menores (céntimos) para evitar errores de
//    redondeo de coma flotante en cálculos monetarios (A06 - diseño seguro).
//  - Las contraseñas se guardan solo como hash Argon2id y los secretos TOTP cifrados con
//    AES-256-GCM (A04).
//  - Los refresh tokens se guardan solo como hash SHA-256 (A07).
//  - El registro de auditoría está encadenado mediante HMAC-SHA256 (A08/A09).
//  - Los valores de tipo enumerado se validan en la capa de aplicación con Zod para
//    mantener la compatibilidad entre SQLite y PostgreSQL.

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  name              String
  passwordHash      String
  role              String    @default("USER") // USER | AUDITOR | ADMIN
  status            String    @default("ACTIVE") // ACTIVE | DISABLED
  currency          String    @default("EUR") // EUR | USD | CLP
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  mfaEnabled        Boolean   @default(false)
  mfaSecretEnc      String?
  mfaPendingSecretEnc String?
  mfaLastUsedStep   Int?
  passwordChangedAt DateTime  @default(now())
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions        Session[]
  loginChallenges LoginChallenge[]
  categories      Category[]
  expenses        Expense[]
}

/// Sesión de usuario (familia de refresh tokens). Permite revocación inmediata.
model Session {
  id           String    @id @default(uuid())
  userId       String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?
  ip           String?
  userAgent    String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

/// Refresh token rotatorio. Solo se almacena el hash; un token ya usado que se vuelve a
/// presentar indica robo del token y provoca la revocación de toda la sesión.
model RefreshToken {
  id        String    @id @default(uuid())
  sessionId String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// Desafío de segundo factor emitido tras validar la contraseña (un solo uso, 5 minutos).
model LoginChallenge {
  id        String    @id @default(uuid())
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String   @default("#4f46e5")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([userId, name])
  @@index([userId])
}

model Expense {
  id            String    @id @default(uuid())
  userId        String
  categoryId    String
  amountMinor   Int
  date          DateTime
  description   String
  merchant      String?
  paymentMethod String    @default("CARD") // CASH | CARD | TRANSFER | OTHER
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  receipt  Receipt?

  @@index([userId, date])
  @@index([categoryId])
}

/// Justificante adjunto a un gasto. El fichero se guarda fuera de la raíz web con un nombre
/// aleatorio; el nombre original solo se conserva (saneado) para mostrarlo al usuario.
model Receipt {
  id           String   @id @default(uuid())
  expenseId    String   @unique
  storedName   String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  createdAt    DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

/// Registro de auditoría de eventos de seguridad, encadenado con HMAC-SHA256
/// (cada entrada incluye el hash de la anterior) para detectar manipulaciones.
model AuditLog {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  action     String
  outcome    String // SUCCESS | FAILURE | DENIED
  userId     String?
  actorEmail String?
  targetType String?
  targetId   String?
  ip         String?
  userAgent  String?
  requestId  String?
  details    String?
  prevHash   String
  hash       String   @unique

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([ip, createdAt])
}

/// Alerta de seguridad generada por las reglas de detección (A09: logging & alerting).
model SecurityAlert {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now())
  type           String
  severity       String // LOW | MEDIUM | HIGH | CRITICAL
  message        String
  userId         String?
  ip             String?
  details        String?
  acknowledgedAt DateTime?
  acknowledgedBy String?

  @@index([createdAt])
  @@index([type, createdAt])
}
